# 민감 정보 — .env 파일에 실제 값을 채워서 사용

DB_HOST=localhost
DB_PORT=5432
DB_NAME=jinbon
DB_USER=jinbon
DB_PASSWORD=
SERVER_PORT=8070

# 허용할 오리진을 쉼표로 구분해 나열한다. 비워두면 모든 오리진을 허용하므로
# 배포 환경에서는 반드시 채울 것.
#
# 주의: 서버 자신의 공개 주소를 빠뜨리지 말 것.
#   앱은 회원가입·로그인 시 {서버주소}/auth.html을 WebView로 열고, 그 페이지가
#   같은 오리진으로 POST /api/signup/token을 호출한다. same-origin이지만
#   Fetch 표준상 POST는 Origin 헤더를 보내므로 Spring CorsFilter가 CORS 요청으로
#   판정한다. 목록에 없으면 403 "Invalid CORS request"가 JSON이 아닌 평문으로
#   떨어지고, WebView는 JSON 파싱 실패로 "인증을 시작하지 못했습니다"를 띄운다.
#   (GET은 Origin을 보내지 않아 인증 화면 자체는 정상적으로 뜨므로 원인을 찾기 어렵다.)
#
# 예) https://api.example.com,https://verify.example.com,http://localhost:8071
CORS_ALLOWED_ORIGINS=

OMNIONE_CX_URL=
BLOCKCHAIN_API_URL=
BLOCKCHAIN_API_TOKEN=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK=omnione
BLOCKCHAIN_CHAIN_ID=
# TODO(deployment): 변경된 contracts/JinBon.sol을 신규 배포한 뒤 새 주소 입력
CONTRACT_ADDRESS=
# 컨트랙트를 배포한 동일 지갑 주소를 사용
WALLET_ADDRESS=
# src/main/resources/keystore/omnione-chain-keystore.json도 동일 배포 지갑이어야 함
KEYSTORE_PASSWORD=
JWT_SECRET=
CI_HMAC_SECRET=
OPENDID_ENABLED=false
OPENDID_VC_CLAIM_NAMESPACE=
