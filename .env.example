# 민감 정보 — .env 파일에 실제 값을 채워서 사용

DB_PASSWORD=
DB_PORT=5432
SERVER_PORT=8070
OMNIONE_CX_URL=
BLOCKCHAIN_API_URL=
BLOCKCHAIN_API_TOKEN=
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK=omnione
BLOCKCHAIN_CHAIN_ID=
# TODO(deployment): 변경된 contracts/JinBon.sol을 신규 배포한 뒤 새 주소 입력
CONTRACT_ADDRESS=
# 컨트랙트를 배포한 동일 지갑 주소를 사용
WALLET_ADDRESS=
# src/main/resources/keystore/omnione-chain-keystore.json도 동일 배포 지갑이어야 함
KEYSTORE_PASSWORD=
JWT_SECRET=
CI_HMAC_SECRET=
OPENDID_ENABLED=false
OPENDID_VC_CLAIM_NAMESPACE=
